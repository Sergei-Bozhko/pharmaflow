@page "/sites"
@rendermode InteractiveServer
@using PharmaFlow.Web.Services
@inject PharmaFlowApiClient Api

<PageTitle>Sites</PageTitle>

<h1>Sites</h1>

<div class="card mb-4">
    <div class="card-header">Create a site (assigned to a study)</div>
    <div class="card-body">
        @if (_studies.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                No studies exist yet — <a href="studies">create a study</a> first to assign a site to it.
            </div>
        }
        else
        {
            <EditForm Model="_form" OnValidSubmit="SubmitAsync">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Study</label>
                        <InputSelect class="form-select" @bind-Value="_form.StudyId">
                            @foreach (var s in _studies)
                            {
                                <option value="@s.Id">@s.ProtocolNumber — @s.Title</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Site #</label>
                        <InputText class="form-control" @bind-Value="_form.SiteNumber" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Country</label>
                        <InputText class="form-control" maxlength="2" @bind-Value="_form.Country" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100" disabled="@_busy">Create</button>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Name</label>
                        <InputText class="form-control" @bind-Value="_form.Name" />
                    </div>
                </div>
            </EditForm>
            <small class="text-muted d-block mt-2">Principal investigator is auto-assigned (demo) — no user setup needed.</small>
        }

        @if (_message is not null)
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3 mb-0">@_message</div>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">All sites (@_sites.Count)</h2>
    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
</div>

<table class="table table-sm table-striped align-middle">
    <thead>
        <tr><th>Site #</th><th>Name</th><th>Country</th><th>Study</th><th>Status</th><th>Created</th></tr>
    </thead>
    <tbody>
        @foreach (var s in _sites)
        {
            <tr>
                <td><code>@s.SiteNumber</code></td>
                <td>@s.Name</td>
                <td>@s.Country</td>
                <td>@StudyLabel(s.StudyId)</td>
                <td><span class="badge text-bg-secondary">@s.Status</span></td>
                <td>@s.CreatedAt.LocalDateTime.ToString("g")</td>
            </tr>
        }
        @if (_sites.Count == 0)
        {
            <tr><td colspan="6" class="text-muted">No sites yet.</td></tr>
        }
    </tbody>
</table>

@code {
    private readonly SiteForm _form = new();
    private IReadOnlyList<StudyRow> _studies = [];
    private IReadOnlyList<SiteRow> _sites = [];
    private bool _busy;
    private bool _isError;
    private string? _message;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _studies = await Api.StudiesAsync();
            _sites = await Api.SitesAsync();
            if (_form.StudyId == Guid.Empty && _studies.Count > 0)
            {
                _form.StudyId = _studies[0].Id;
            }
        }
        catch (Exception ex) { _isError = true; _message = $"Load failed: {ex.Message}"; }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var error = await Api.CreateSiteAsync(new CreateSiteRequest(
                _form.StudyId, _form.SiteNumber, _form.Name,
                _form.Country.ToUpperInvariant(), Guid.NewGuid()));

            _isError = error is not null;
            _message = error ?? $"Created site {_form.SiteNumber}.";
            if (error is null)
            {
                await LoadAsync();
            }
        }
        catch (Exception ex) { _isError = true; _message = ex.Message; }
        finally { _busy = false; }
    }

    private string StudyLabel(Guid studyId)
    {
        var study = _studies.FirstOrDefault(s => s.Id == studyId);
        return study is not null ? study.ProtocolNumber : studyId.ToString()[..8];
    }

    private sealed class SiteForm
    {
        public Guid StudyId { get; set; }
        public string SiteNumber { get; set; } = "001";
        public string Name { get; set; } = "Boston General Hospital";
        public string Country { get; set; } = "US";
    }
}
