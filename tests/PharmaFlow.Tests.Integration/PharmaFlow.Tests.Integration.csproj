<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>PharmaFlow.Tests.Integration</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PharmaFlow.Api\PharmaFlow.Api.csproj" />
    <ProjectReference Include="..\..\src\PharmaFlow.Application\PharmaFlow.Application.csproj" />
    <ProjectReference Include="..\..\src\PharmaFlow.Domain\PharmaFlow.Domain.csproj" />
    <ProjectReference Include="..\..\src\PharmaFlow.Infrastructure\PharmaFlow.Infrastructure.csproj" />
  </ItemGroup>

</Project>
